#!/usr/bin/env bash

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
source "$repo_root/scripts/git-hooks/common.sh"

changed_files="$(collect_push_files)"

if [ -z "$changed_files" ]; then
  echo "ℹ️ No files detected in push range, skipping pre-push"
  exit 0
fi

classify_paths <<< "$changed_files"

if [ "$HAS_DOCS_ONLY" -eq 1 ] && [ "$HAS_SUPPORT_MATRIX" -eq 0 ]; then
  echo "📝 Documentation-only change, skipping tests and type checks"
  exit 0
fi

log_dir="$(git rev-parse --git-path hooks-logs)"
mkdir -p "$log_dir"
default_log_path="$log_dir/pre-push.log"
log_path="${HOOK_LOG_PATH:-$default_log_path}"

: > "$log_path"

print_line() {
  printf "%s\n" "$1" | tee -a "$log_path"
}

run_step() {
  local label="$1"
  shift
  local cmd="$*"

  print_line ""
  print_line "══════════════════════════════════════════════════"
  print_line "▶ ${label}"
  print_line "Command: ${cmd}"
  print_line "══════════════════════════════════════════════════"

  if is_dry_run; then
    print_line "◌ DRY RUN: ${label}"
    print_line "✓ SKIPPED (dry run): ${label}"
    return 0
  fi

  set +e
  "$@" 2>&1 | tee -a "$log_path"
  local status=${PIPESTATUS[0]}
  set -e

  if [ "$status" -ne 0 ]; then
    print_line ""
    print_line "✗ FAILED: ${label}"
    print_line "Failing command: ${cmd}"
    print_line "Exit code: ${status}"
    print_line "Full log: ${log_path}"
    return "$status"
  fi

  print_line "✓ PASSED: ${label}"
}

print_line "📦 Push scopes: $(describe_detected_scopes)"
print_line "Changed files:"
while IFS= read -r file; do
  print_line "  - ${file}"
done <<< "$changed_files"

mapfile -t hook_files < <(hook_shell_files_from_paths <<< "$changed_files")
if [ "${#hook_files[@]}" -gt 0 ]; then
  run_step "Hook shell syntax" bash -n "${hook_files[@]}"
fi

if [ "$HAS_FRONTEND" -eq 1 ]; then
  run_step "TypeScript type check" npm run typecheck
  run_step "Frontend tests" npm run test
fi

if [ "$HAS_RUST" -eq 1 ]; then
  run_step "Rust lint (clippy)" npm run lint:rust
  run_step "Rust tests (unit + integration)" npm run test:rust
fi

if [ "$HAS_SUPPORT_MATRIX" -eq 1 ]; then
  run_step "Generate SUPPORT_MATRIX.md" npm run gen:docs

  if ! is_dry_run && ! git diff --exit-code docs/SUPPORT_MATRIX.md > /dev/null 2>&1; then
    print_line ""
    print_line "✗ FAILED: SUPPORT_MATRIX freshness check"
    print_line "Failing command: git diff --exit-code docs/SUPPORT_MATRIX.md"
    print_line "Exit code: 1"
    print_line "docs/SUPPORT_MATRIX.md is STALE."
    print_line "Run: npm run gen:docs"
    print_line "Then commit the updated file before pushing."
    print_line "Full log: ${log_path}"
    exit 1
  fi
fi

print_line ""
print_line "✅ All pre-push checks passed"
print_line "Log file: ${log_path}"
