#!/usr/bin/env bash

# Check if this is a documentation-only change
is_doc_only() {
  # Get list of files changed compared to the base branch
  # For pushes, compare against the remote tracking branch
  base=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || echo "origin/main")
  changed=$(git diff --name-only "$base"...HEAD 2>/dev/null || git diff --name-only HEAD~1 HEAD)
  
  # If no changed files, not doc-only
  if [ -z "$changed" ]; then
    return 1
  fi
  
  # Check if any file is NOT a documentation file
  for file in $changed; do
    case "$file" in
      *.md|*.txt|LICENSE|*.rst|docs/*|.husky/*)
        # Documentation file, continue checking
        ;;
      *)
        # Non-documentation file found
        return 1
        ;;
    esac
  done
  
  # All files are documentation
  return 0
}

# Skip hooks for documentation-only changes
if is_doc_only; then
  echo "📝 Documentation-only change, skipping tests and type checks"
  exit 0
fi

set -euo pipefail

log_dir="$(git rev-parse --git-path hooks-logs)"
mkdir -p "$log_dir"
default_log_path="$log_dir/pre-push.log"
log_path="${HOOK_LOG_PATH:-$default_log_path}"

: > "$log_path"

print_line() {
  printf "%s\n" "$1" | tee -a "$log_path"
}

run_step() {
  local label="$1"
  shift
  local cmd="$*"

  print_line ""
  print_line "══════════════════════════════════════════════════"
  print_line "▶ ${label}"
  print_line "Command: ${cmd}"
  print_line "══════════════════════════════════════════════════"

  set +e
  "$@" 2>&1 | tee -a "$log_path"
  local status=${PIPESTATUS[0]}
  set -e

  if [ "$status" -ne 0 ]; then
    print_line ""
    print_line "✗ FAILED: ${label}"
    print_line "Failing command: ${cmd}"
    print_line "Exit code: ${status}"
    print_line "Full log: ${log_path}"
    return "$status"
  fi

  print_line "✓ PASSED: ${label}"
}

run_step "TypeScript type check" npm run typecheck
run_step "Rust lint (clippy)" npm run lint:rust
run_step "Frontend tests" npm run test
run_step "Rust tests (unit + integration)" npm run test:rust

run_step "Generate SUPPORT_MATRIX.md" npm run gen:docs

if ! git diff --exit-code docs/SUPPORT_MATRIX.md > /dev/null 2>&1; then
  print_line ""
  print_line "✗ FAILED: SUPPORT_MATRIX freshness check"
  print_line "Failing command: git diff --exit-code docs/SUPPORT_MATRIX.md"
  print_line "Exit code: 1"
  print_line "docs/SUPPORT_MATRIX.md is STALE."
  print_line "Run: npm run gen:docs"
  print_line "Then commit the updated file before pushing."
  print_line "Full log: ${log_path}"
  exit 1
fi

print_line ""
print_line "✅ All pre-push checks passed"
print_line "Log file: ${log_path}"
